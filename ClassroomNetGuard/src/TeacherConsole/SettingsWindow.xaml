<Window x:Class="TeacherConsole.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 网站白名单与下载策略" Width="640" Height="640" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#EDF1EF">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="网站白名单" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left"/>
                    <Border DockPanel.Dock="Right" Background="#E4F1EC" CornerRadius="10" Padding="8,3">
                        <TextBlock Text="白名单制 · 默认全拦" FontSize="10.5" Foreground="#0A5C4C" FontWeight="Bold"/>
                    </Border>
                </DockPanel>

                <TextBlock FontSize="11" Foreground="#7C8A85" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,8">
                    支持：域名（baidu.com，含全部子域名）、通配域（*.edu.cn）、
                    IP 地址（10.114.105.5）、IP:端口（10.114.105.5:8000，仅放行该端口）、
                    IP 段通配（10.114.105.*）、IP 网段（10.114.105.0/24）。
                </TextBlock>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AllowInput" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                             Padding="8,0" BorderBrush="#D8E0DC" Text=""
                             ToolTip="输入域名或 IP，如 baidu.com / *.edu.cn / 10.114.105.5 / 10.114.105.5:8000 / 10.114.105.* / 10.114.105.0/24，回车或点添加"/>
                    <Button Grid.Column="1" Content="添加" Height="32" Margin="8,0,0,0" Padding="14,0"
                            Background="#0E7C66" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Click="AddAllow_Click"/>
                </Grid>
                <TextBlock x:Name="TxtAllowHint" Text="" FontSize="10.5" Foreground="#DC2626" MinHeight="14" Margin="2,0,0,6"/>

                <ListBox x:Name="AllowList" Height="170" BorderBrush="#E0E6E3" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="AllowList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="RemoveAllowBtn" Content="移除选中项" Margin="0,8,0,0" Height="30" IsEnabled="False"
                        Background="#FDEBEA" Foreground="#B91C1C" FontWeight="Bold" BorderThickness="1"
                        BorderBrush="#F3C7C3" Click="RemoveAllow_Click"/>

                <Border Height="1" Background="#E0E6E3" Margin="0,18,0,16"/>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="下载策略" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="TxtDlState" DockPanel.Dock="Right" FontSize="10.5" Foreground="#55645F" VerticalAlignment="Center"/>
                </DockPanel>

                <CheckBox x:Name="DlEnable" Content="允许学生下载文件" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,10" Checked="DlPolicy_Changed" Unchecked="DlPolicy_Changed"/>

                <StackPanel x:Name="DlDetail" IsEnabled="False" Opacity="0.6">
                    <TextBlock Text="允许的文件类型" FontSize="11" Foreground="#7C8A85" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="TypeBox" Margin="0,0,0,12">
                        <CheckBox x:Name="TypePdf" Content="pdf" Tag="pdf" Margin="0,0,16,6" FontSize="12" Checked="Type_Changed" Unchecked="Type_Changed"/>
                        <CheckBox x:Name="TypeDocx" Content="docx" Tag="docx" Margin="0,0,16,6" FontSize="12" Checked="Type_Changed" Unchecked="Type_Changed"/>
                        <CheckBox x:Name="TypePptx" Content="pptx" Tag="pptx" Margin="0,0,16,6" FontSize="12" Checked="Type_Changed" Unchecked="Type_Changed"/>
                        <CheckBox x:Name="TypeZip" Content="zip" Tag="zip" Margin="0,0,16,6" FontSize="12" Checked="Type_Changed" Unchecked="Type_Changed"/>
                        <CheckBox x:Name="TypeXlsx" Content="xlsx" Tag="xlsx" Margin="0,0,16,6" FontSize="12" Checked="Type_Changed" Unchecked="Type_Changed"/>
                    </WrapPanel>
                    <DockPanel>
                        <TextBlock Text="单文件上限" FontSize="11" Foreground="#7C8A85" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <ComboBox x:Name="SizeSel" DockPanel.Dock="Right" Width="120" FontSize="12" SelectionChanged="SizeSel_Changed">
                            <ComboBoxItem Content="10 MB" Tag="10"/>
                            <ComboBoxItem Content="50 MB" Tag="50"/>
                            <ComboBoxItem Content="200 MB" Tag="200"/>
                            <ComboBoxItem Content="不限" Tag="0"/>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="修改即时下发到全部学生机" FontSize="11" Foreground="#7C8A85" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="关闭" Width="90" Height="32" Background="#0E7C66" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
