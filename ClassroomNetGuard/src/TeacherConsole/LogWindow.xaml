<Window x:Class="TeacherConsole.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时日志" Height="460" Width="620" WindowStartupLocation="CenterOwner"
        Background="#EDF1EF" Icon="pack://application:,,,/app.ico">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E0E6E3" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="清空" FontSize="11" Foreground="#7C8A85"
                        Background="Transparent" BorderThickness="0" Click="ClearLogs_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="筛选：" FontSize="11" Foreground="#55645F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="FAll" Content="全部" FontSize="11" Foreground="#55645F" Margin="0,0,12,0" IsChecked="True" GroupName="lg" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FBlock" Content="拦截" FontSize="11" Foreground="#55645F" Margin="0,0,12,0" GroupName="lg" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FAllow" Content="放行" FontSize="11" Foreground="#55645F" Margin="0,0,12,0" GroupName="lg" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FPolicy" Content="策略" FontSize="11" Foreground="#55645F" GroupName="lg" Checked="Filter_Changed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E0E6E3" BorderThickness="1">
            <ListBox x:Name="LogList" BorderThickness="0" Padding="12,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="10.5" Foreground="#7C8A85" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Device}" FontSize="11.5" FontWeight="SemiBold" Foreground="#55645F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Event}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding Result}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#55645F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Result}" Value="拦截"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="放行"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Result}" Value="策略"><Setter Property="Foreground" Value="#D97706"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
