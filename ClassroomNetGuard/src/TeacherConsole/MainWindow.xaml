<Window x:Class="TeacherConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上网管控系统 · 教师端" Icon="pack://application:,,,/app.ico" Height="820" Width="1380"
        MinWidth="1120" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#EDF1EF" Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <!-- 设备图标卡片模板：紧凑尺寸，一屏尽量放下 7×7 台；在线亮 / 离线暗 -->
        <DataTemplate x:Key="DevTemplate">
            <Border Width="126" Height="92" Margin="0,0,6,6" Background="#FBFCFB"
                    BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.4" CornerRadius="10"
                    MouseLeftButtonUp="DevCard_Click" Cursor="Hand">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="17"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="27"/>
                    </Grid.RowDefinitions>

                    <!-- 状态行 -->
                    <DockPanel Grid.Row="0" Margin="8,3,8,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{Binding StatusTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UnlockStatusText}" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{Binding UnlockStatusBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </DockPanel>

                    <!-- 图标 + 计算机名（离线整体变暗） -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{Binding CardBrushBg}"
                                Opacity="{Binding IconOpacity}">
                            <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                       Foreground="{Binding CardBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Seat}" FontSize="11" FontWeight="Bold" Foreground="{Binding NameBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="112"/>
                        <TextBlock Text="{Binding Ip}" FontSize="8.5" Foreground="{Binding SubBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- 操作行 -->
                    <DockPanel Grid.Row="2" Margin="6,0,6,5" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="重新拦截" FontSize="8.5" Padding="4,1" Margin="4,0,0,0"
                                Background="#B91C1C" Foreground="White" BorderThickness="0" Click="DevRelock_Click"
                                Visibility="{Binding RelockVisibility}" VerticalAlignment="Center"
                                ToolTip="立即恢复该学生机的课堂管控"/>
                        <ToggleButton Content="{Binding ModeText}" Background="{Binding ModeBrush}" Foreground="White"
                                      FontSize="9" FontWeight="Bold" Padding="6,1" BorderThickness="0"
                                      IsChecked="{Binding ClassroomOn, Mode=TwoWay}" Click="DevModeToggle_Click"
                                      VerticalAlignment="Center" ToolTip="单独切换该设备的管控/自由模式"/>
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 日志行模板 -->
        <DataTemplate x:Key="LogTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="10.5" Foreground="#7C8A85" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Device}" FontSize="11.5" FontWeight="SemiBold" Foreground="#55645F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Event}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Result}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#55645F"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result}" Value="拦截"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                <DataTrigger Binding="{Binding Result}" Value="放行"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger>
                                <DataTrigger Binding="{Binding Result}" Value="策略"><Setter Property="Foreground" Value="#D97706"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="#14211E" Padding="18,11">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#0E7C66" CornerRadius="8" Width="34" Height="34">
                        <TextBlock Text="管" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="上网管控系统" Foreground="White" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="教师端控制台 · 局域网教室" Foreground="#9FB8B0" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtServer" Text="服务未启动" Foreground="#FF9D9D" FontSize="12" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <TextBlock x:Name="TxtOnline" Text="在线 0/0" Foreground="White" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtBlocked" Text="拦截 0" Foreground="#F5C37C" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ToggleButton x:Name="ModeToggle" Checked="ModeToggle_Changed" Unchecked="ModeToggle_Changed"
                                  Background="#0E7C66" Foreground="White" FontWeight="Bold" Padding="14,6"
                                  Content="课堂管控" BorderThickness="0" IsChecked="True"/>
                    <Button x:Name="LogsBtn" Content="实时日志"
                            Background="#22332E" Foreground="#CFE3DC" FontSize="12.5" Padding="14,6" Margin="10,0,0,0"
                            BorderThickness="0" Click="Logs_Click"
                            ToolTip="查看学生机上线/下线/解锁/策略实时日志"/>
                    <Button x:Name="SettingsBtn" Content="设置"
                            Background="#22332E" Foreground="#CFE3DC" FontSize="12.5" Padding="14,6" Margin="12,0,0,0"
                            BorderThickness="0" Click="Settings_Click"
                            ToolTip="网站白名单 / 下载策略（支持域名与 IP 格式）"/>
                    <Button x:Name="ExportBtn" Content="导出密码"
                            Background="#22332E" Foreground="#CFE3DC" FontSize="12.5" Padding="14,6" Margin="10,0,0,0"
                            BorderThickness="0" Click="ExportPasswords_Click"
                            ToolTip="导出全部学生机的解锁密码清单（CSV）；未设置的生成当天默认密码"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主区：班级设备图标墙（实时日志在右上角"实时日志"窗口） -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E0E6E3" BorderThickness="1" Margin="12">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="#E0E6E3" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="班级设备" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDevSub" Text="" FontSize="11" Foreground="#7C8A85" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,4,12">
                    <ItemsControl x:Name="DevList" ItemTemplate="{StaticResource DevTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
